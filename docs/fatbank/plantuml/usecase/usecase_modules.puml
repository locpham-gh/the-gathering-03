@startuml

actor "Authenticated User" as User
actor "Event Host" as Host
actor "SMTP Provider" as SMTP

User <|-- Host

rectangle "Integrated Modules" {
    usecase "UC-10 Schedule Event" as UC10
    usecase "UC-11 Manage Own Events" as UC11
    usecase "UC-12 Post Forum Topic" as UC12
    usecase "UC-13 Access Digital Library" as UC13
    usecase "UC-14 Toggle Theme" as UC14
    usecase "UC-15 Open Fullscreen" as UC15
    usecase "UC-16 Use Whiteboard" as UC16
}

User -- UC12
User -- UC13
User -- UC14
User -- UC15
User -- UC16

Host -- UC10
Host -- UC11

UC10 -- SMTP

@enduml
