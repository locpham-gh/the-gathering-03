@startuml
skinparam componentStyle rectangle
skinparam packageStyle frame

title System Overview - The Gathering Project

actor "User" as User

package "The Gathering Platform" {
    component [Frontend Application\n(React + PixiJS)] as Client
    component [Backend Server\n(Bun + ElysiaJS)] as Server
    database "MongoDB Atlas\n(Data Storage)" as DB
}

cloud "External Services" {
    [Google Identity Service\n(OAuth 2.0)] as Google
    [SMTP Service\n(Gmail OTP/Invite)] as SMTP
    [LiveKit Cloud\n(WebRTC Audio/Video)] as LiveKit
}

' Interactions
User <--> Client : Interaction & Feedback
Client <--> Server : REST API / WebSockets
Server <--> DB : Persistence (Mongoose)

' External Interactions
Server --> Google : Verify Identity
Server --> SMTP : Send Email Payloads
Client <--> LiveKit : Media Streaming (WebRTC)
Server --> LiveKit : Issue Access Tokens

@enduml
