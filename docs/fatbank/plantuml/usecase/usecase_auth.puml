@startuml

actor Guest
actor "Authenticated User" as User
actor "Google Identity" as Google
actor "SMTP Provider" as SMTP

rectangle "Authentication Module" {
    usecase "UC-01 Login with Google" as UC01
    usecase "UC-02 Login with Email OTP" as UC02
    usecase "UC-03 Update Profile" as UC03
}

Guest -- UC01
Guest -- UC02
User -- UC03

UC01 -- Google
UC02 -- SMTP

@enduml
