@startuml

actor "Authenticated User" as User
actor "Room Owner" as Owner

User <|-- Owner

rectangle "Multiplayer and Room" {
    usecase "UC-04 Create Room" as UC04
    usecase "UC-05 Join Room" as UC05
    usecase "UC-06 Manage Members" as UC06
    usecase "UC-07 Enter 2D Room" as UC07
    usecase "UC-08 Sync Position" as UC08
    usecase "UC-18 View Mini-map" as UC18
    usecase "UC-19 Phone Interaction" as UC19
    usecase "UC-21 Seat Snapping" as UC21
}

User -- UC05
User -- UC07
User -- UC08
User -- UC18
User -- UC19
User -- UC21

Owner -- UC04
Owner -- UC06

@enduml
